# App Store Connect API key. The key is shared across all apps on the team,
# so point at one copy rather than checking a .p8 into each repo.
# Values come from App Store Connect > Users and Access > Integrations > Keys.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_PATH=$HOME/.appstoreconnect/private_keys/AuthKey_$ASC_KEY_ID.p8

# App Review contact info lives in fastlane/metadata/review_information/
# (gitignored - it holds a personal phone number). Recreate it with:
#   first_name.txt last_name.txt phone_number.txt email_address.txt notes.txt
